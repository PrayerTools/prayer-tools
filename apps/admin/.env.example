## Core
## Load every Nuxtinator layer from a local checkout instead of the refs in layers.lock.json
# NUXTINATOR_SOURCE_DIR=/path/to/nuxtinator
APP_TITLE=Prayer.Tools
## BYPASSRLS role: migrations, operator cross-site views
DATABASE_URL=postgres://pt2_admin:dev@localhost:5432/prayer_tools_v3_with_orgs_3
## RLS-enforced role: every request
APP_DATABASE_URL=postgres://pt2_app:dev@localhost:5432/prayer_tools_v3_with_orgs_3
NODE_ENV=development
NUXT_PORT=2480
NUXT_PUBLIC_SITE_URL=http://localhost:2480
## Prefix for session and active-org cookie names. Set a different one per app
## when several run on the same hostname (e.g. localhost on different ports),
## otherwise signing in to one signs you out of the others.
NUXT_PUBLIC_COOKIE_PREFIX=v2prayer_admin_
## openssl rand -base64 32
JWT_SECRET=
## openssl rand -hex 32 (64 hex chars)
NUXT_SECRET_ENCRYPTION_KEY=
## openssl rand -base64 32
NUXT_TENANT_FLOW_SECRET=

## prayer.tools (must match the public server and the worker)
PT_SECRET=
PT_SITE_BASE_HOST=localhost:3480
PT_ADMIN_URL=http://localhost:2480
# PT_PLATFORM_HOST=prayer.tools
# PT_DONATE_URL=https://prayer.tools/give

## Mail. Development: SMTP to Mailpit (localhost:1025). Production: MAIL_PROVIDER=mailgun.
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_DOMAIN_TRANSACTIONAL=mail.prayer.tools
MAIL_DOMAIN_MARKETING=news.prayer.tools
MAILGUN_API_KEY=
MAILGUN_HOST=
## Mailgun HTTP webhook signing key (Settings → API Keys); webhook URL: /api/pt/webhooks/mailgun
MAILGUN_WEBHOOK_SIGNING_KEY=
## Core's own mail (password resets, invites) via the email-mailgun layer
MAILGUN_DOMAIN=
SMTP_FROM=noreply@prayer.tools
SMTP_FROM_NAME=Prayer.Tools

## Inbox layer (contact messages and stories)
INBOX_DOMAIN=inbox.prayer.tools
INBOX_CONTACT_ADDRESS=contact@inbox.prayer.tools
## Every site shares INBOX_DOMAIN; a site's inbox address is <slug>@INBOX_DOMAIN
INBOX_SLUG_ADDRESSES=true

## AI (OpenRouter) for translation and inbox drafts; enable models in Admin → AI
OPENROUTER_API_KEY=

## Object storage for images (without it, uploads are stored in .data/uploads)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_BUCKET_NAME=
S3_PUBLIC_BASE_URL=

## Cloudflare for SaaS (custom domains); without a token, domains are checked by DNS only
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_FALLBACK_ORIGIN=sites.prayer.tools

## Sign in with Google / Apple (social-auth layer); each turns on when its web credentials are set.
## Redirect URLs: <NUXT_PUBLIC_SITE_URL>/api/social-auth/google/callback and …/apple/callback
NUXT_SOCIAL_AUTH_GOOGLE_CLIENT_ID=
NUXT_SOCIAL_AUTH_GOOGLE_CLIENT_SECRET=
NUXT_SOCIAL_AUTH_APPLE_SERVICES_ID=
NUXT_SOCIAL_AUTH_APPLE_TEAM_ID=
NUXT_SOCIAL_AUTH_APPLE_KEY_ID=
NUXT_SOCIAL_AUTH_APPLE_PRIVATE_KEY=

## Turnstile on site creation
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

## Statinator (campaign_created events)
STATINATOR_URL=
STATINATOR_PROJECT_ID=prayer_tools_campaigns
STATINATOR_API_KEY=

## Feedback widget (Prayer.Tools board)
PT_FEEDBACK_API_BASE=https://apps.gospelambition.org
PT_FEEDBACK_PROJECT_ID=

## Marketing sends
MARKETING_THROTTLE_PER_MINUTE=300
