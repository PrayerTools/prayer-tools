# Database: the RLS-enforced app role only (never the admin/bypass role).
APP_DATABASE_URL=postgres://pt2_app:dev@localhost:5432/prayer_tools_v3_with_orgs_3

# Shared with the admin app and the worker (signs manage/unsubscribe/personal links).
PT_SECRET=change-me

# Hosts. Sites live at {slug}.PT_SITE_BASE_HOST; api./go. hosts and the platform
# host (My prayer) derive from it unless set explicitly.
PT_SITE_BASE_HOST=localhost:3480
# PT_SITE_SCHEME=https
# PT_PLATFORM_HOST=prayer.tools
# PT_API_HOST=api.prayer.tools
# PT_GO_HOST=go.prayer.tools
PT_ADMIN_URL=http://localhost:2480
# true behind a proxy (Cloudflare, Caddy, Railway) that sets X-Forwarded-Host /
# -Proto / -For and CF-Connecting-IP; unset, they are ignored. Set it in
# production, or every visitor shares the proxy's address for rate limits.
# PT_TRUST_PROXY=true
# Where the platform host's "/" redirects; unset, "/" shows the landing page.
PT_MARKETING_URL=https://prayer.tools
PT_DONATE_URL=https://prayer.tools/give

# Email (Mailpit in development).
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# MAILGUN_API_KEY=
# MAILGUN_HOST=api.mailgun.net
MAIL_DOMAIN_TRANSACTIONAL=mail.prayer.tools
MAIL_DOMAIN_MARKETING=news.prayer.tools

# Cloudflare Turnstile on public forms (the widget shows only with a site key;
# without a secret every token passes).
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Statinator analytics relay (forwarding no-ops when unset).
STATINATOR_URL=
STATINATOR_PROJECT_ID=prayer_tools_campaigns
STATINATOR_API_KEY=

# Google / Apple sign-in on the signup form (hidden when unset).
GOOGLE_CLIENT_ID=
APPLE_SERVICES_ID=

# Mobile app: store links (the landing "app" section and the signup page's
# app option show once one is set) and universal / app links.
PT_APP_STORE_URL=
PT_PLAY_STORE_URL=
# apple-app-site-association: comma-separated TEAMID.bundle.id values.
PT_APPLE_APP_IDS=
# assetlinks.json
PT_ANDROID_PACKAGE=
PT_ANDROID_SHA256=

# Feedback widget (Nuxtinator feedback web component); off when the project id is empty.
PT_FEEDBACK_API_BASE=https://apps.gospelambition.org
PT_FEEDBACK_PROJECT_ID=

## Replies to site emails go to the site inbox, <slug>@INBOX_DOMAIN (same values as the admin app)
INBOX_DOMAIN=inbox.prayer.tools
INBOX_SLUG_ADDRESSES=true
